MONGO_URI=mongodb://localhost:27017
MONGO_DB=clipboardDB
APP_PORT=8080

# Legacy JWTs remain available only while username accounts are migrated.
JWT_SECRET=replace-with-a-long-random-secret

# WorkOS AuthKit / Magic Auth
WORKOS_API_KEY=sk_test_replace_me
WORKOS_CLIENT_ID=client_replace_me

# Browser session and frontend access
SESSION_COOKIE_NAME=clipman_session
SESSION_COOKIE_SECURE=false
SESSION_DURATION=720h
CORS_ALLOW_ORIGINS=http://localhost:5173
